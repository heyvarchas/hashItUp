# Copy this file to .env and adjust values for local development.
# .env itself must never be committed (see .gitignore).

POSTGRES_USER=welfare_admin
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=welfare_db

# Used by the backend to connect to Postgres (wired in docker-compose.yml).
# Not yet consumed by application code — that lands in Task 1.2/1.3
# when SQLAlchemy models and the DB session are introduced.
DATABASE_URL=postgresql://welfare_admin:changeme_dev_only@db:5432/welfare_db